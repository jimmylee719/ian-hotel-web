{
  // The top level is the local / preview environment. It sets the mock payment and channel modes, so:
  //  - workers_dev is false: a stray bare `wrangler deploy` must not publish a mock-pay Worker on workers.dev;
  //  - ENVIRONMENT is "local": getDeps accepts the mock modes only then (lib/runtime/deps.ts), so even a
  //    deployed copy of this env cannot take bookings anywhere but a local dev server.
  // Production is env.production: no PAYMENT_MODE / CHANNEL_MODE (booking stays off until Plans 4 and 5),
  // ENVIRONMENT "production" (mock modes refused, /dev/pay 404s), served on a custom domain, not workers.dev.
  // Staging is env.staging: its own Worker, D1 and R2 bucket, the same crons, ENVIRONMENT "staging" (mock modes
  // refused, vendor endpoints must be on the sandbox lists in lib/runtime/config-guard.ts, BASE_URL required).
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "nk-booking",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "nk-booking" }],
  // */5: holds, sync retry, pre-arrival; */15: gateway reconcile; 0 20 (04:00 Taipei): channel reconcile (lib/jobs/cron.ts).
  "triggers": { "crons": ["*/5 * * * *", "*/15 * * * *", "0 20 * * *"] },
  "workers_dev": false,
  // CF_ACCESS_* are left empty locally: the admin then uses DEV_STAFF_EMAIL from .dev.vars instead of a JWT.
  "vars": {
    "ENVIRONMENT": "local", "PAYMENT_MODE": "mock", "CHANNEL_MODE": "mock",
    "CF_ACCESS_TEAM_DOMAIN": "", "CF_ACCESS_AUD": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nk-booking",
      "database_id": "local",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "nk-media" }],
  // Cloudflare Images: WebP width variants of admin photo uploads (lib/admin/uploads.ts). Without it, only the original is stored.
  "images": { "binding": "IMAGES" },
  "env": {
    "production": {
      "name": "nk-booking-production",
      "main": "worker.ts",
      "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "nk-booking-production" }],
      "triggers": { "crons": ["*/5 * * * *", "*/15 * * * *", "0 20 * * *"] },
      "workers_dev": false,
      // Set both CF_ACCESS_* to the Zero Trust team domain and the admin Access application's AUD tag
      // before deploying; while either is empty every /admin request is 401 (fails closed).
      "vars": { "ENVIRONMENT": "production", "CF_ACCESS_TEAM_DOMAIN": "", "CF_ACCESS_AUD": "" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nk-booking",
          "database_id": "REPLACE_WITH_PRODUCTION_D1_ID",
          "migrations_dir": "drizzle/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "nk-media" }],
      "images": { "binding": "IMAGES" }
    },
    // Staging: a full copy of production on its own resources, for the vendor sandboxes (SiteMinder sandbox,
    // SinoPac test environment) and for rehearsing migrations. Deployed with `npm run deploy:staging`.
    // No PAYMENT_MODE / CHANNEL_MODE yet: the real adapters do not exist (Tasks 3 and 5), and mock modes are refused
    // outside ENVIRONMENT=local, so booking stays off here until the sandbox adapters are configured. Secrets
    // (RESEND_API_KEY, STAFF_EMAILS, OPS_EMAILS, BASE_URL, the vendors' sandbox credentials) are set with
    // `wrangler secret put <NAME> --env staging`; never production values. See docs/DEPLOY.md, Staging.
    "staging": {
      "name": "nk-booking-staging",
      "main": "worker.ts",
      "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "nk-booking-staging" }],
      "triggers": { "crons": ["*/5 * * * *", "*/15 * * * *", "0 20 * * *"] },
      "workers_dev": false,
      // Fill both CF_ACCESS_* with the staging Access application's values; while either is empty /admin is 401.
      "vars": { "ENVIRONMENT": "staging", "CF_ACCESS_TEAM_DOMAIN": "", "CF_ACCESS_AUD": "" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nk-booking-staging",
          "database_id": "REPLACE_WITH_STAGING_D1_ID",
          "migrations_dir": "drizzle/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "nk-media-staging" }],
      "images": { "binding": "IMAGES" }
    }
  }
}
