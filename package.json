{
  "name": "nk-booking",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "tsx scripts/fetch-fonts.ts",
    "dev": "next dev",
    "prebuild": "tsx scripts/fetch-fonts.ts",
    "build": "next build",
    "preview": "tsx scripts/fetch-fonts.ts && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "typecheck": "tsc --noEmit",
    "deploy": "vitest run && tsc --noEmit && tsx scripts/fetch-fonts.ts && opennextjs-cloudflare build --env production && opennextjs-cloudflare deploy --env production",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply nk-booking --local",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "media:variants": "tsx scripts/media-variants.ts"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.18",
    "next": "15.5.29",
    "next-intl": "^4.16.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.20.18",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-sqlite3": "^13.2.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "node-html-parser": "^9.0.7",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}
